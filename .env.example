# Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Obtain your Chat ID from @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional Camera Source (0 for default webcam, or RTSP/HTTP URL)
CAMERA_SOURCE=0
